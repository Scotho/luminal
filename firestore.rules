rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.username is string
                    && request.resource.data.username.size() >= 3
                    && request.resource.data.username.size() <= 20;
      allow update: if request.auth != null && request.auth.uid == uid
                    && (!('about' in request.resource.data) || (request.resource.data.about is string && request.resource.data.about.size() <= 280))
                    && (!('socials' in request.resource.data) || request.resource.data.socials is map)
                    && (!('createdAt' in request.resource.data)
                        || !('createdAt' in resource.data)
                        || request.resource.data.createdAt == resource.data.createdAt);
    }

    // Username uniqueness index
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Matchmaking queue
    match /queue/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if request.auth != null;
    }

    // Online matches
    match /onlineMatches/{matchId} {
      allow read: if request.auth != null;
      // players is now an array of {uid, username, color} maps.
      // Firestore rules cannot check array-of-maps membership, so we trust
      // that only authenticated users can create — the Firestore transaction
      // in matchmaking.ts already verifies both queue docs are 'waiting'.
      allow create: if request.auth != null
                    && request.resource.data.players is list
                    && request.resource.data.players.size() >= 2;
      // Updates (status transitions, etc.) must come from a participant.
      // We can only check index 0/1 without a Cloud Function, which covers 2-player.
      // N-player updates should go through Cloud Functions.
      allow update: if request.auth != null
                    && (resource.data.players[0].uid == request.auth.uid
                        || resource.data.players[1].uid == request.auth.uid);
    }

    // Leaderboard stats
    match /leaderboard/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && request.auth.uid == resource.data.uid;
    }

    // Friends — requests subcollection
    match /friends/{uid}/requests/{fromUid} {
      // Owner can read all their requests; sender can read their own request doc
      allow read: if request.auth != null
                  && (request.auth.uid == uid || request.auth.uid == fromUid);
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.auth.uid == fromUid;
      allow delete: if request.auth != null
                    && (request.auth.uid == uid || request.auth.uid == fromUid);
    }

    // Friends — list subcollection
    match /friends/{uid}/list/{friendUid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, delete: if request.auth != null
                            && request.auth.token.firebase.sign_in_provider != 'anonymous'
                            && (request.auth.uid == uid || request.auth.uid == friendUid);
    }

    // Chat messages
    match /chat/{messageId} {
      allow read: if true;
      // System announcements must come from Cloud Functions (admin SDK bypasses rules).
      // No client-side SYSTEM message path — removes spoofing vector entirely.
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 200;
    }

    // Match history (Phase 2)
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participantUids;
      allow update, delete: if false;
    }
  }
}
