{
  "name": "luminal",
  "version": "1.0.10",
  "description": "Multiplayer light-cycle arena game for the browser (unfinished, early alpha)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs live",
    "build:local": "node scripts/build.mjs local",
    "build:test": "node scripts/build.mjs test",
    "build:live": "node scripts/build.mjs live",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.js",
    "deploy:test": "npm run build:test && firebase deploy --only hosting:luminal-test --project luminal-game",
    "deploy:live": "npm run build:live && firebase deploy --only hosting:luminal-game --project luminal-game",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/record-coverage.js",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:t1": "vitest run --config vitest.e2e.config.ts src/e2e/__tests__/casual.e2e.test.ts src/e2e/__tests__/lobby.e2e.test.ts",
    "test:e2e:soak": "vitest run --config vitest.e2e.config.ts src/e2e/__tests__/soak.e2e.test.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "inspect": "node scripts/inspect.js",
    "test:ui": "node scripts/ui-tests.js",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:watch": "vitest --config vitest.browser.config.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:online": "vitest run --config vitest.online.config.ts",
    "seed": "npx tsx scripts/seed.ts",
    "seed:stress": "npx tsx scripts/seed.ts --set stress",
    "reset": "npx tsx scripts/reset.ts",
    "reset:stress": "npx tsx scripts/reset.ts --seed-set stress",
    "local": "npx tsx scripts/local-stack.ts",
    "local:no-vite": "npx tsx scripts/local-stack.ts --no-vite",
    "schema:check": "npx tsx scripts/schema-check.ts",
    "schema:bump": "npx tsx scripts/schema-bump.ts",
    "perf-budget": "npx tsx scripts/perf-budget.ts"
  },
  "keywords": [],
  "author": "Craig Smith",
  "license": "MIT",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/Scotho/luminal.git" },
  "dependencies": {
    "cobe": "^2.0.1",
    "firebase": "^12.11.0",
    "marked": "^17.0.6",
    "postprocessing": "^6.39.0",
    "prismjs": "^1.30.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@playwright/test": "^1.59.1",
    "@types/marked": "^5.0.2",
    "@types/node-cron": "^3.0.11",
    "@types/three": "^0.183.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.6.0",
    "firebase-admin": "^13.7.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "node-cron": "^4.2.1",
    "playwright": "^1.59.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
