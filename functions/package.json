{
  "name": "luminal-functions",
  "description": "Cloud Functions for Luminal anticheat and ranked infrastructure",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
    "fast-check": "^4.6.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.2"
  },
  "private": true
}
